{
  "manifest_version": 3,
  "name": "Arena Auto Native — IA autonome dans Documents (zéro clic)",
  "version": "1.0.0",
  "description": "L'agent Arena lit, crée et écrit dans Documents toute seule, sans confirmation ni sélecteur de dossier, via un programme local verrouillé sur Documents.",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["https://arena.ai/*", "https://lmarena.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arena Auto Native",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://arena.ai/*", "https://lmarena.ai/*"],
      "js": ["autofs.js", "native.js"],
      "css": ["native.css"],
      "run_at": "document_idle"
    }
  ]
}
