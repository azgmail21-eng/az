{
  "manifest_version": 3,
  "name": "Arena Documents Bridge",
  "version": "2.0.0",
  "description": "Permet à Agent Mode d'agir automatiquement sur les fichiers du dossier Documents, et uniquement celui-ci.",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://arena.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://arena.ai/agent*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Arena Documents Bridge"
  }
}
